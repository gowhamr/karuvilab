{
  "name": "karuvilab",
  "version": "1.0.0",
  "description": "KaruviLab – fast, private browser tools",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitest/ui": "^1.6.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  }
}

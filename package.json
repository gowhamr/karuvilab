{
  "name": "karuvilab",
  "version": "2.1.0",
  "description": "KaruviLab – fast, private browser tools",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/generate-registries.mjs",
    "build": "next build --webpack && node scripts/check-bundle-budgets.mjs",
    "check-budgets": "node scripts/check-bundle-budgets.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "generate-tool": "node scripts/scaffold-tool.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import ./scripts/register-hooks.mjs scripts/run-unit-tests.mjs",
    "test:ui": "vitest --ui",
    "postinstall": "node scripts/check-ts-version.mjs && node scripts/sync-workers.mjs",
    "prebuild": "node scripts/generate-registries.mjs && node scripts/sync-workers.mjs"
  },
  "devDependencies": {
